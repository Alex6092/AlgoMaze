JWT_SECRET=remplacer_par_une_chaine_aleatoire_longue
REDIS_USER=default
REDIS_PASSWORD=mot_de_passe_redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Évaluation IA via le load balancer d'inférence (application « AlgoMaze », clé en mode async).
LB_URL=https://ia.example.com
LB_API_KEY=
LB_MODEL=qwen/qwen3.5-9b
# URL publique du callback, joignable par le load balancer.
LB_CALLBACK_URL=https://algomaze.example.com/lb/callback
# Secret de callback de l'application AlgoMaze sur le load balancer.
LB_CALLBACK_SECRET=
# Optionnel : sortie maximale demandée (défaut 2048) et période de la relève de secours (défaut 120 s).
# LB_MAX_TOKENS=2048
# FEEDBACK_POLL_SECONDS=120
# Secret partagé HMAC pour le SSO Moodle (mod algomazevalidation).
# À régler aussi dans Moodle : Administration → Plugins → Activités → Algomaze validation.
MOODLE_SHARED_SECRET=remplacer_par_un_secret_long_et_aleatoire

# Optionnel — Intégration EFE (Évaluation par Compétences).
# Si EFE_API_BASE_URL et EFE_API_KEY sont renseignés, AlgoMaze remonte
# automatiquement le niveau de maîtrise de chaque étudiant (avec moodleId connu)
# vers EFE après chaque évaluation IA, et propose un push manuel depuis /progress.
# EFE_API_BASE_URL=https://efe.tspro.fr/apiMoodle
# EFE_API_KEY=
# Code de la compétence évaluée par AlgoMaze (cf. GET /apiMoodle/competences).
# EFE_COMPETENCE_CODE=
# Identifiant idempotent du devoir "progression globale" (ne pas changer).
# EFE_DEVOIR_KEY=algomaze_progress_ongoing
# Libellé affiché côté EFE pour le devoir "progression globale".
# EFE_DEVOIR_LABEL=AlgoMaze — Progression globale
